# PostgreSQL接続文字列（docker-composeのdbサービスに対応。ホスト側は5433で公開している。
# ローカルにPostgreSQLサービスがインストール済みで5432を使用している場合との競合を避けるため）
DATABASE_URL="postgresql://eventboard:eventboard@localhost:5433/eventboard?schema=public"

# Access/Refresh Token署名鍵（32文字以上のランダム文字列を設定すること）
JWT_ACCESS_SECRET="please-change-this-access-secret-to-random-32chars"
JWT_REFRESH_SECRET="please-change-this-refresh-secret-to-random-32chars"

# フロントエンドのベースURL（CORS許可オリジンとして使用）
APP_BASE_URL="http://localhost:5173"

# シード投入時の初期Adminアカウント
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Node.jsプロセスのタイムゾーン固定（日時比較バグを避けるため）
TZ="Asia/Tokyo"
